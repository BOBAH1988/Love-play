# Переменные окружения бэкенда. Скопировать в /etc/come-on-play.env
# и закрыть права: chmod 600 /etc/come-on-play.env
# Ни одно значение из этого файла не должно попадать в git.

# Адрес, по которому открывается приложение. В письмах используются ссылки отсюда.
PUBLIC_URL=https://example.ru

# Админы. Через запятую. Уровень admin у них будет всегда.
ADMIN_EMAILS=79042044926@ya.ru

# База. Файл вне репозитория, чтобы деплой его не затирал.
DB_FILE=/srv/come-on-play/data/come-on-play.db

# Локально за Caddy слушаем только 127.0.0.1.
HOST=127.0.0.1
PORT=8080
COOKIE_SECURE=1

# Ограничение запросов на IP в минуту (вход, регистрация, сброс пароля).
RATE_LIMIT_PER_MINUTE=30

# Почта. Без SMTP письма пишутся в лог, и после переезда войти не смогут
# перенесённые аккаунты — заполнить до переключения режима 'server'.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.ru

# Firebase — только для переноса данных; потом можно удалить.
# Пустое значение = взять из firebase-config.js в корне проекта.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
